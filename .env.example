# OpenETL Test Board. Copy to .env and fill in. .env is not committed.
# Folder of the OpenETL data lab (default: ../openetl-data-lab next to this repo).
OPENETL_LAB=../openetl-data-lab
# Folder of the OpenETL repo checkout (default: ../openetl next to this repo).
OPENETL_REPO=../openetl
# Relata server used by the Relata scenarios.
RELATA_URL=http://127.0.0.1:9090
# Relata registry token. If empty, the app reads RELATA_TOKEN from the openetl repo's .env.
RELATA_TOKEN=
RELATA_TENANT=
# How many scenarios run at the same time (default 1).
TEST_CONCURRENCY=1
