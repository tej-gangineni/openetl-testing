{
  "id": "E30-jsonl-rss-feed",
  "title": "JSONL via API: the 3-item lab feed becomes lines from 3 documents",
  "tracker_row": "api-E30",
  "summary": "Submits rss (the 3-item lab feed) -> a jsonl file through the API and checks 3 items were read, lines equal records, all lines are valid with text, and exactly 3 source documents are represented.",
  "flow": {
    "source": {
      "kind": "http",
      "label": "lab feed.xml (3 items)",
      "detail": "http://127.0.0.1:8765/feed.xml"
    },
    "engine": {
      "label": "POST /api/v1/jobs (rss -> jsonl)"
    },
    "target": {
      "kind": "files",
      "label": "out.jsonl",
      "detail": "${lab}/state/e2e/e30-*"
    }
  },
  "tags": [
    "api",
    "lab-db"
  ],
  "resources": [
    "openetl:api"
  ],
  "steps": [
    {
      "id": "out",
      "phase": "prepare",
      "title": "Create a fresh output folder",
      "explain": "A JSONL sink appends, so each run needs an empty file.",
      "action": "fixture.outDir",
      "args": {
        "name": "e30"
      },
      "save": "out"
    },
    {
      "id": "runSubmit",
      "phase": "trigger",
      "title": "Submit the job through the API",
      "explain": "POST /api/v1/jobs with the TOML base64-encoded, exactly as the console does.",
      "action": "openetl.api.submitJob",
      "args": {
        "specFile": "scenarios/e2e/E30.toml",
        "name": "e2e_E30_jsonl_rss"
      },
      "save": "runSub"
    },
    {
      "id": "runWait",
      "phase": "observe",
      "title": "Wait for the run to finish",
      "explain": "Polls the task result and GET /api/v1/runs until this run reaches a terminal status.",
      "action": "openetl.api.waitRun",
      "args": {
        "name": "e2e_E30_jsonl_rss",
        "after": "${runSub.submittedAt}",
        "taskId": "${runSub.taskId}",
        "timeoutSec": 300
      },
      "save": "run"
    },
    {
      "id": "runStatus",
      "phase": "observe",
      "title": "Run finished COMPLETED",
      "explain": "A clean run must report COMPLETED, not PARTIAL or FAILED.",
      "action": "check.compare",
      "args": {
        "left": "${run.status}",
        "op": "eq",
        "right": "COMPLETED"
      }
    },
    {
      "id": "runRecs",
      "phase": "observe",
      "title": "The run read some records",
      "explain": "A run that reads nothing proves nothing.",
      "action": "check.compare",
      "args": {
        "left": "${run.records}",
        "op": "gt",
        "right": 0
      }
    },
    {
      "id": "files",
      "phase": "observe",
      "title": "Run read the 3 feed items",
      "explain": "The lab feed has 3 items.",
      "action": "check.compare",
      "args": {
        "left": "${run.files}",
        "op": "eq",
        "right": 3
      }
    },
    {
      "id": "stats",
      "phase": "verify",
      "title": "Read the JSONL file",
      "explain": "What the sink really wrote.",
      "action": "fs.jsonlStats",
      "args": {
        "file": "${out.file}",
        "field": "source_uri"
      },
      "save": "jl"
    },
    {
      "id": "linesEq",
      "phase": "verify",
      "title": "Lines equal records reported",
      "explain": "One line per record.",
      "action": "check.compare",
      "args": {
        "left": "${jl.lines}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "valid",
      "phase": "verify",
      "title": "Every line is valid JSON",
      "explain": "No broken lines.",
      "action": "check.compare",
      "args": {
        "left": "${jl.invalid}",
        "op": "eq",
        "right": 0
      }
    },
    {
      "id": "text",
      "phase": "verify",
      "title": "Every line has text",
      "explain": "An empty chunk is a lost item.",
      "action": "check.compare",
      "args": {
        "left": "${jl.withText}",
        "op": "eq",
        "right": "${jl.lines}"
      }
    },
    {
      "id": "docs",
      "phase": "verify",
      "title": "Lines come from 3 documents",
      "explain": "One document per feed item.",
      "action": "check.compare",
      "args": {
        "left": "${jl.distinct}",
        "op": "eq",
        "right": 3
      }
    },
    {
      "id": "clean",
      "phase": "verify",
      "title": "Remove the output folder",
      "explain": "Leaves no test files behind.",
      "action": "fs.removeE2e",
      "args": {
        "path": "${out.dir}"
      },
      "always": true
    }
  ]
}
