{
  "id": "E28-pg-local-ssh-logs",
  "title": "Postgres via API: 10 SSH log parts become rows that match the source",
  "tracker_row": "api-E28",
  "summary": "Submits local (SSH log parts SSH-000000..9, filtered) -> postgres table e2e_ssh_logs through the API and checks rows equal records reported, the filter picked exactly the 10 matching files, every file is in the table, and sshd lines arrived.",
  "flow": {
    "source": {
      "kind": "files",
      "label": "10 SSH log parts",
      "detail": "${lab}/downloads/logs-parts/SSH/SSH-00000*.log"
    },
    "engine": {
      "label": "POST /api/v1/jobs (local -> postgres)"
    },
    "target": {
      "kind": "postgres",
      "label": "table e2e_ssh_logs",
      "detail": "127.0.0.1:5433/openetl"
    }
  },
  "tags": [
    "api",
    "lab-db"
  ],
  "resources": [
    "openetl:api",
    "postgres:lab"
  ],
  "steps": [
    {
      "id": "drop",
      "phase": "prepare",
      "title": "Drop e2e_ssh_logs",
      "explain": "Starts clean so every row counted later was written by this run.",
      "action": "pg.dropTable",
      "args": {
        "table": "e2e_ssh_logs"
      }
    },
    {
      "id": "srcFiles",
      "phase": "prepare",
      "title": "Count matching source files",
      "explain": "The filter should select these files only.",
      "action": "fs.countFiles",
      "args": {
        "dir": "${lab}/downloads/logs-parts/SSH",
        "glob": "SSH-00000*.log"
      },
      "save": "srcFiles"
    },
    {
      "id": "runSubmit",
      "phase": "trigger",
      "title": "Submit the job through the API",
      "explain": "POST /api/v1/jobs with the TOML base64-encoded, exactly as the console does.",
      "action": "openetl.api.submitJob",
      "args": {
        "specFile": "scenarios/e2e/E28.toml",
        "name": "e2e_E28_pg_ssh"
      },
      "save": "runSub"
    },
    {
      "id": "runWait",
      "phase": "observe",
      "title": "Wait for the run to finish",
      "explain": "Polls the task result and GET /api/v1/runs until this run reaches a terminal status.",
      "action": "openetl.api.waitRun",
      "args": {
        "name": "e2e_E28_pg_ssh",
        "after": "${runSub.submittedAt}",
        "taskId": "${runSub.taskId}",
        "timeoutSec": 300
      },
      "save": "run"
    },
    {
      "id": "runStatus",
      "phase": "observe",
      "title": "Run finished COMPLETED",
      "explain": "A clean run must report COMPLETED, not PARTIAL or FAILED.",
      "action": "check.compare",
      "args": {
        "left": "${run.status}",
        "op": "eq",
        "right": "COMPLETED"
      }
    },
    {
      "id": "runDeliv",
      "phase": "observe",
      "title": "Delivered equals records read",
      "explain": "Every record the run read must be reported as delivered to the sink.",
      "action": "check.compare",
      "args": {
        "left": "${run.delivered}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "runFailed",
      "phase": "observe",
      "title": "No record failed",
      "explain": "records_failed must be 0 on a clean run.",
      "action": "check.compare",
      "args": {
        "left": "${run.failed}",
        "op": "eq",
        "right": 0
      }
    },
    {
      "id": "runRecs",
      "phase": "observe",
      "title": "The run read some records",
      "explain": "A run that reads nothing proves nothing.",
      "action": "check.compare",
      "args": {
        "left": "${run.records}",
        "op": "gt",
        "right": 0
      }
    },
    {
      "id": "files",
      "phase": "observe",
      "title": "Run read exactly the matching files",
      "explain": "The filter must not read more or fewer files.",
      "action": "check.compare",
      "args": {
        "left": "${run.files}",
        "op": "eq",
        "right": "${srcFiles}"
      }
    },
    {
      "id": "count",
      "phase": "verify",
      "title": "Count rows in e2e_ssh_logs",
      "explain": "The real number of rows the sink wrote.",
      "action": "pg.scalar",
      "args": {
        "sql": "SELECT count(*) FROM e2e_ssh_logs"
      },
      "save": "rows"
    },
    {
      "id": "rowsEq",
      "phase": "verify",
      "title": "Rows equal records reported",
      "explain": "The table must hold what the run delivered.",
      "action": "check.compare",
      "args": {
        "left": "${rows}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "perFile",
      "phase": "verify",
      "title": "Count distinct source files in the table",
      "explain": "Every file must be represented.",
      "action": "pg.scalar",
      "args": {
        "sql": "SELECT count(DISTINCT source_filename) FROM e2e_ssh_logs"
      },
      "save": "df"
    },
    {
      "id": "perFileEq",
      "phase": "verify",
      "title": "Distinct files equal matching files",
      "explain": "No file lost, none extra.",
      "action": "check.compare",
      "args": {
        "left": "${df}",
        "op": "eq",
        "right": "${srcFiles}"
      }
    },
    {
      "id": "spot",
      "phase": "verify",
      "title": "Count rows with sshd lines",
      "explain": "Spot-check that log content arrived.",
      "action": "pg.scalar",
      "args": {
        "sql": "SELECT count(*) FROM e2e_ssh_logs WHERE text LIKE '%sshd[%'"
      },
      "save": "spot"
    },
    {
      "id": "spotGt",
      "phase": "verify",
      "title": "Some rows hold sshd lines",
      "explain": "Every SSH log part has sshd lines.",
      "action": "check.compare",
      "args": {
        "left": "${spot}",
        "op": "gt",
        "right": 0
      }
    },
    {
      "id": "clean",
      "phase": "verify",
      "title": "Drop e2e_ssh_logs",
      "explain": "Removes the test table.",
      "action": "pg.dropTable",
      "args": {
        "table": "e2e_ssh_logs"
      },
      "always": true
    }
  ]
}
