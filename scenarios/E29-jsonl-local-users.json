{
  "id": "E29-jsonl-local-users",
  "title": "JSONL via API: 10 user files become 10 valid lines",
  "tracker_row": "api-E29",
  "summary": "Submits local (10 user JSON files) -> a jsonl file under state/e2e through the API and checks the file: lines equal records, every line is valid JSON, every source file is represented, every line carries this run id, and a known email appears once.",
  "flow": {
    "source": {
      "kind": "files",
      "label": "10 user .json files",
      "detail": "${lab}/downloads/json-items/users"
    },
    "engine": {
      "label": "POST /api/v1/jobs (local -> jsonl)"
    },
    "target": {
      "kind": "files",
      "label": "out.jsonl",
      "detail": "${lab}/state/e2e/e29-*"
    }
  },
  "tags": [
    "api",
    "lab-db"
  ],
  "resources": [
    "openetl:api"
  ],
  "steps": [
    {
      "id": "out",
      "phase": "prepare",
      "title": "Create a fresh output folder",
      "explain": "A JSONL sink appends, so each run needs an empty file.",
      "action": "fixture.outDir",
      "args": {
        "name": "e29"
      },
      "save": "out"
    },
    {
      "id": "srcFiles",
      "phase": "prepare",
      "title": "Count source files",
      "explain": "One user per file.",
      "action": "fs.countFiles",
      "args": {
        "dir": "${lab}/downloads/json-items/users",
        "glob": "*.json"
      },
      "save": "srcFiles"
    },
    {
      "id": "runSubmit",
      "phase": "trigger",
      "title": "Submit the job through the API",
      "explain": "POST /api/v1/jobs with the TOML base64-encoded, exactly as the console does.",
      "action": "openetl.api.submitJob",
      "args": {
        "specFile": "scenarios/e2e/E29.toml",
        "name": "e2e_E29_jsonl_users"
      },
      "save": "runSub"
    },
    {
      "id": "runWait",
      "phase": "observe",
      "title": "Wait for the run to finish",
      "explain": "Polls the task result and GET /api/v1/runs until this run reaches a terminal status.",
      "action": "openetl.api.waitRun",
      "args": {
        "name": "e2e_E29_jsonl_users",
        "after": "${runSub.submittedAt}",
        "taskId": "${runSub.taskId}",
        "timeoutSec": 300
      },
      "save": "run"
    },
    {
      "id": "runStatus",
      "phase": "observe",
      "title": "Run finished COMPLETED",
      "explain": "A clean run must report COMPLETED, not PARTIAL or FAILED.",
      "action": "check.compare",
      "args": {
        "left": "${run.status}",
        "op": "eq",
        "right": "COMPLETED"
      }
    },
    {
      "id": "runRecs",
      "phase": "observe",
      "title": "The run read some records",
      "explain": "A run that reads nothing proves nothing.",
      "action": "check.compare",
      "args": {
        "left": "${run.records}",
        "op": "gt",
        "right": 0
      }
    },
    {
      "id": "files",
      "phase": "observe",
      "title": "Run read every source file",
      "explain": "Files read must equal files on disk.",
      "action": "check.compare",
      "args": {
        "left": "${run.files}",
        "op": "eq",
        "right": "${srcFiles}"
      }
    },
    {
      "id": "stats",
      "phase": "verify",
      "title": "Read the JSONL file",
      "explain": "What the sink really wrote.",
      "action": "fs.jsonlStats",
      "args": {
        "file": "${out.file}",
        "field": "source_filename",
        "contains": "Sincere@april.biz"
      },
      "save": "jl"
    },
    {
      "id": "linesEq",
      "phase": "verify",
      "title": "Lines equal records reported",
      "explain": "One line per record.",
      "action": "check.compare",
      "args": {
        "left": "${jl.lines}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "valid",
      "phase": "verify",
      "title": "Every line is valid JSON",
      "explain": "A JSONL file with broken lines is unusable.",
      "action": "check.compare",
      "args": {
        "left": "${jl.invalid}",
        "op": "eq",
        "right": 0
      }
    },
    {
      "id": "perFile",
      "phase": "verify",
      "title": "Every source file is represented",
      "explain": "No file lost.",
      "action": "check.compare",
      "args": {
        "left": "${jl.distinct}",
        "op": "eq",
        "right": "${srcFiles}"
      }
    },
    {
      "id": "spot",
      "phase": "verify",
      "title": "The email Sincere@april.biz appears on one line",
      "explain": "Spot-check of real field values.",
      "action": "check.compare",
      "args": {
        "left": "${jl.mentions}",
        "op": "eq",
        "right": 1
      }
    },
    {
      "id": "runIds",
      "phase": "verify",
      "title": "Read the run ids stamped on the lines",
      "explain": "Provenance: lines must name the run that wrote them.",
      "action": "fs.jsonlStats",
      "args": {
        "file": "${out.file}",
        "field": "job_run_id"
      },
      "save": "rid"
    },
    {
      "id": "oneRun",
      "phase": "verify",
      "title": "All lines carry one run id",
      "explain": "One run wrote the file.",
      "action": "check.compare",
      "args": {
        "left": "${rid.distinct}",
        "op": "eq",
        "right": 1
      }
    },
    {
      "id": "thisRun",
      "phase": "verify",
      "title": "That run id is this run",
      "explain": "The id must match the API run record.",
      "action": "check.compare",
      "args": {
        "left": "${rid.distinctValues.0}",
        "op": "eq",
        "right": "${run.run_id}"
      }
    },
    {
      "id": "clean",
      "phase": "verify",
      "title": "Remove the output folder",
      "explain": "Leaves no test files behind.",
      "action": "fs.removeE2e",
      "args": {
        "path": "${out.dir}"
      },
      "always": true
    }
  ]
}
