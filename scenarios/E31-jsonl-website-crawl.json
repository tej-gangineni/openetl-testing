{
  "id": "E31-jsonl-website-crawl",
  "title": "JSONL via API: crawling the lab site reaches every page",
  "tracker_row": "api-E31",
  "summary": "Submits website (crawl of the lab web server) -> a jsonl file through the API and checks the crawl read at least every HTML page in the lab pages folder plus the index, lines equal records, and every page read is represented by its URL.",
  "flow": {
    "source": {
      "kind": "http",
      "label": "lab website",
      "detail": "http://127.0.0.1:8765/"
    },
    "engine": {
      "label": "POST /api/v1/jobs (website -> jsonl)"
    },
    "target": {
      "kind": "files",
      "label": "out.jsonl",
      "detail": "${lab}/state/e2e/e31-*"
    }
  },
  "tags": [
    "api",
    "lab-db"
  ],
  "resources": [
    "openetl:api"
  ],
  "steps": [
    {
      "id": "out",
      "phase": "prepare",
      "title": "Create a fresh output folder",
      "explain": "A JSONL sink appends, so each run needs an empty file.",
      "action": "fixture.outDir",
      "args": {
        "name": "e31"
      },
      "save": "out"
    },
    {
      "id": "pages",
      "phase": "prepare",
      "title": "Count HTML pages the lab site serves",
      "explain": "The crawler should reach all of them from the index.",
      "action": "fs.countFiles",
      "args": {
        "dir": "${lab}/sources/www/pages",
        "glob": "*.html"
      },
      "save": "pages"
    },
    {
      "id": "runSubmit",
      "phase": "trigger",
      "title": "Submit the job through the API",
      "explain": "POST /api/v1/jobs with the TOML base64-encoded, exactly as the console does.",
      "action": "openetl.api.submitJob",
      "args": {
        "specFile": "scenarios/e2e/E31.toml",
        "name": "e2e_E31_jsonl_website"
      },
      "save": "runSub"
    },
    {
      "id": "runWait",
      "phase": "observe",
      "title": "Wait for the run to finish",
      "explain": "Polls the task result and GET /api/v1/runs until this run reaches a terminal status.",
      "action": "openetl.api.waitRun",
      "args": {
        "name": "e2e_E31_jsonl_website",
        "after": "${runSub.submittedAt}",
        "taskId": "${runSub.taskId}",
        "timeoutSec": 420
      },
      "save": "run"
    },
    {
      "id": "runStatus",
      "phase": "observe",
      "title": "Run finished COMPLETED",
      "explain": "A clean run must report COMPLETED, not PARTIAL or FAILED.",
      "action": "check.compare",
      "args": {
        "left": "${run.status}",
        "op": "eq",
        "right": "COMPLETED"
      }
    },
    {
      "id": "runRecs",
      "phase": "observe",
      "title": "The run read some records",
      "explain": "A run that reads nothing proves nothing.",
      "action": "check.compare",
      "args": {
        "left": "${run.records}",
        "op": "gt",
        "right": 0
      }
    },
    {
      "id": "files",
      "phase": "observe",
      "title": "Run read more pages than the lab pages folder holds",
      "explain": "Every page plus the index must be read (strictly more than the page count).",
      "action": "check.compare",
      "args": {
        "left": "${run.files}",
        "op": "gt",
        "right": "${pages}"
      }
    },
    {
      "id": "stats",
      "phase": "verify",
      "title": "Read the JSONL file",
      "explain": "What the sink really wrote.",
      "action": "fs.jsonlStats",
      "args": {
        "file": "${out.file}",
        "field": "source_uri"
      },
      "save": "jl"
    },
    {
      "id": "linesEq",
      "phase": "verify",
      "title": "Lines equal records reported",
      "explain": "One line per record.",
      "action": "check.compare",
      "args": {
        "left": "${jl.lines}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "valid",
      "phase": "verify",
      "title": "Every line is valid JSON",
      "explain": "No broken lines.",
      "action": "check.compare",
      "args": {
        "left": "${jl.invalid}",
        "op": "eq",
        "right": 0
      }
    },
    {
      "id": "perPage",
      "phase": "verify",
      "title": "Every page read is represented by its URL",
      "explain": "Pages read must equal distinct source URLs in the output.",
      "action": "check.compare",
      "args": {
        "left": "${jl.distinct}",
        "op": "eq",
        "right": "${run.files}"
      }
    },
    {
      "id": "clean",
      "phase": "verify",
      "title": "Remove the output folder",
      "explain": "Leaves no test files behind.",
      "action": "fs.removeE2e",
      "args": {
        "path": "${out.dir}"
      },
      "always": true
    }
  ]
}
