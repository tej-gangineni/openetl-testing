{
  "id": "E35-es-local-healthapp-logs",
  "title": "Elasticsearch via API: 10 HealthApp log parts become documents that match the source",
  "tracker_row": "api-E35",
  "summary": "Submits local (HealthApp log parts HealthApp-000000..9) -> Elasticsearch index e2e_healthapp_logs through the API and checks documents equal records reported and every file is represented.",
  "flow": {
    "source": {
      "kind": "files",
      "label": "10 HealthApp log parts",
      "detail": "${lab}/downloads/logs-parts/HealthApp/HealthApp-00000*.log"
    },
    "engine": {
      "label": "POST /api/v1/jobs (local -> elasticsearch)"
    },
    "target": {
      "kind": "elasticsearch",
      "label": "index e2e_healthapp_logs",
      "detail": "127.0.0.1:9200"
    }
  },
  "tags": [
    "api",
    "lab-db"
  ],
  "resources": [
    "openetl:api",
    "elasticsearch:lab"
  ],
  "steps": [
    {
      "id": "drop",
      "phase": "prepare",
      "title": "Delete index e2e_healthapp_logs",
      "explain": "Starts clean.",
      "action": "es.dropIndex",
      "args": {
        "index": "e2e_healthapp_logs"
      }
    },
    {
      "id": "srcFiles",
      "phase": "prepare",
      "title": "Count matching source files",
      "explain": "The filter should select these files only.",
      "action": "fs.countFiles",
      "args": {
        "dir": "${lab}/downloads/logs-parts/HealthApp",
        "glob": "HealthApp-00000*.log"
      },
      "save": "srcFiles"
    },
    {
      "id": "runSubmit",
      "phase": "trigger",
      "title": "Submit the job through the API",
      "explain": "POST /api/v1/jobs with the TOML base64-encoded, exactly as the console does.",
      "action": "openetl.api.submitJob",
      "args": {
        "specFile": "scenarios/e2e/E35.toml",
        "name": "e2e_E35_es_healthapp"
      },
      "save": "runSub"
    },
    {
      "id": "runWait",
      "phase": "observe",
      "title": "Wait for the run to finish",
      "explain": "Polls the task result and GET /api/v1/runs until this run reaches a terminal status.",
      "action": "openetl.api.waitRun",
      "args": {
        "name": "e2e_E35_es_healthapp",
        "after": "${runSub.submittedAt}",
        "taskId": "${runSub.taskId}",
        "timeoutSec": 300
      },
      "save": "run"
    },
    {
      "id": "runStatus",
      "phase": "observe",
      "title": "Run finished COMPLETED",
      "explain": "A clean run must report COMPLETED, not PARTIAL or FAILED.",
      "action": "check.compare",
      "args": {
        "left": "${run.status}",
        "op": "eq",
        "right": "COMPLETED"
      }
    },
    {
      "id": "runDeliv",
      "phase": "observe",
      "title": "Delivered equals records read",
      "explain": "Every record the run read must be reported as delivered to the sink.",
      "action": "check.compare",
      "args": {
        "left": "${run.delivered}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "runFailed",
      "phase": "observe",
      "title": "No record failed",
      "explain": "records_failed must be 0 on a clean run.",
      "action": "check.compare",
      "args": {
        "left": "${run.failed}",
        "op": "eq",
        "right": 0
      }
    },
    {
      "id": "runRecs",
      "phase": "observe",
      "title": "The run read some records",
      "explain": "A run that reads nothing proves nothing.",
      "action": "check.compare",
      "args": {
        "left": "${run.records}",
        "op": "gt",
        "right": 0
      }
    },
    {
      "id": "files",
      "phase": "observe",
      "title": "Run read exactly the matching files",
      "explain": "Files read must equal matching files.",
      "action": "check.compare",
      "args": {
        "left": "${run.files}",
        "op": "eq",
        "right": "${srcFiles}"
      }
    },
    {
      "id": "count",
      "phase": "verify",
      "title": "Count documents in e2e_healthapp_logs",
      "explain": "The real number of documents indexed.",
      "action": "es.count",
      "args": {
        "index": "e2e_healthapp_logs"
      },
      "save": "docs"
    },
    {
      "id": "docsEq",
      "phase": "verify",
      "title": "Documents equal records reported",
      "explain": "The index must hold what the run delivered.",
      "action": "check.compare",
      "args": {
        "left": "${docs}",
        "op": "eq",
        "right": "${run.records}"
      }
    },
    {
      "id": "perFile",
      "phase": "verify",
      "title": "Distinct source files in the index",
      "explain": "Every file must be represented.",
      "action": "es.distinct",
      "args": {
        "index": "e2e_healthapp_logs",
        "field": "source_filename.keyword"
      },
      "save": "df"
    },
    {
      "id": "perFileEq",
      "phase": "verify",
      "title": "Distinct files equal matching files",
      "explain": "No file lost.",
      "action": "check.compare",
      "args": {
        "left": "${df.length}",
        "op": "eq",
        "right": "${srcFiles}"
      }
    },
    {
      "id": "clean",
      "phase": "verify",
      "title": "Delete index e2e_healthapp_logs",
      "explain": "Removes the test index.",
      "action": "es.dropIndex",
      "args": {
        "index": "e2e_healthapp_logs"
      },
      "always": true
    }
  ]
}
