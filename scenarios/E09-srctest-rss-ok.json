{
  "id": "E09-srctest-rss-ok",
  "title": "Source test: the lab RSS feed passes",
  "tracker_row": "api-E09",
  "summary": "Tests an rss source pointing at the lab feed. The feed is served with HTTP 200, so the test must pass with level tested.",
  "flow": {
    "source": {
      "kind": "http",
      "label": "lab RSS feed",
      "detail": "http://127.0.0.1:8765/feed.xml"
    },
    "engine": {
      "label": "POST /api/v1/sources/test"
    },
    "target": {
      "kind": "http",
      "label": "test result",
      "detail": "ok, stage, level"
    }
  },
  "tags": [
    "api",
    "source-test"
  ],
  "resources": [
    "openetl:api"
  ],
  "steps": [
    {
      "id": "test",
      "phase": "trigger",
      "title": "POST /api/v1/sources/test",
      "explain": "The real source test the console calls before saving a source.",
      "action": "openetl.api.sourceTest",
      "args": {
        "body": {
          "type": "rss",
          "role": "job",
          "config": {
            "url": "http://127.0.0.1:8765/feed.xml"
          }
        }
      },
      "save": "t"
    },
    {
      "id": "ok",
      "phase": "verify",
      "title": "ok is true",
      "explain": "The source is reachable and readable, so the test must pass.",
      "action": "check.compare",
      "args": {
        "left": "${t.ok}",
        "op": "eq",
        "right": true
      }
    },
    {
      "id": "level",
      "phase": "verify",
      "title": "level is tested",
      "explain": "A pass must come from a probe that really ran, not just a config check.",
      "action": "check.compare",
      "args": {
        "left": "${t.level}",
        "op": "eq",
        "right": "tested"
      }
    },
    {
      "id": "stage",
      "phase": "verify",
      "title": "stage is read",
      "explain": "The probe fetched the feed address.",
      "action": "check.compare",
      "args": {
        "left": "${t.stage}",
        "op": "eq",
        "right": "read"
      }
    }
  ]
}
