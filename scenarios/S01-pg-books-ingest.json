{
  "id": "S01-pg-books-ingest",
  "title": "Postgres: books load matches the source",
  "tracker_row": "r047",
  "tags": ["lab", "postgres", "baseline"],
  "resources": ["postgres:lab"],
  "steps": [
    { "id": "empty", "phase": "prepare", "title": "Empty the books table",
      "action": "pg.dropTable", "args": { "table": "books" } },
    { "id": "src", "phase": "prepare", "title": "Count the source .txt files",
      "action": "fs.countFiles", "args": { "dir": "${lab}/downloads/books", "glob": "*.txt" }, "save": "srcFiles" },
    { "id": "run", "phase": "trigger", "title": "Run the pg_books pipeline",
      "action": "openetl.jobRun", "args": { "pipeline": "${lab}/pipelines/pg_books.toml", "cwd": "${lab}", "extras": ["postgres"] }, "save": "run" },
    { "id": "status", "phase": "observe", "title": "Job finished with status COMPLETED",
      "action": "check.compare", "args": { "left": "${run.status}", "op": "eq", "right": "COMPLETED" } },
    { "id": "warn", "phase": "observe", "title": "Job reported no warnings",
      "action": "check.compare", "args": { "left": "${run.warnings}", "op": "eq", "right": 0 } },
    { "id": "files", "phase": "observe", "title": "Job processed every source file",
      "action": "check.compare", "args": { "left": "${run.files}", "op": "eq", "right": "${srcFiles}" } },
    { "id": "distinct", "phase": "verify", "title": "Read distinct source files in the books table",
      "action": "pg.scalar", "args": { "sql": "SELECT count(DISTINCT source_filename) FROM books" }, "save": "distinctFiles" },
    { "id": "distinctEq", "phase": "verify", "title": "Every source file is present in the table",
      "action": "check.compare", "args": { "left": "${distinctFiles}", "op": "eq", "right": "${srcFiles}" } },
    { "id": "count", "phase": "verify", "title": "Read row count of the books table",
      "action": "pg.scalar", "args": { "sql": "SELECT count(*) FROM books" }, "save": "rowCount" },
    { "id": "countEq", "phase": "verify", "title": "Row count equals the records OpenETL reported",
      "action": "check.compare", "args": { "left": "${rowCount}", "op": "eq", "right": "${run.records}" } },
    { "id": "pride", "phase": "verify", "title": "Count pg1342.txt rows that mention 'Pride and Prejudice'",
      "action": "pg.scalar", "args": { "sql": "SELECT count(*) FROM books WHERE source_filename='pg1342.txt' AND text ILIKE '%Pride and Prejudice%'" }, "save": "prideRows" },
    { "id": "prideGt", "phase": "verify", "title": "pg1342.txt text contains 'Pride and Prejudice'",
      "action": "check.compare", "args": { "left": "${prideRows}", "op": "gt", "right": 0 } }
  ]
}
